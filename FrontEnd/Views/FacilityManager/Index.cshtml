@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Facility Manager Dashboard";
    var facilityId = ViewData["FacilityId"];
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-building me-2 text-info"></i>Facility Manager Dashboard</h4>
            <p class="text-muted mb-0">
                Xin chào, <strong>@CurrentUser.FullName</strong> —
                Phụ trách
                @if (facilityId != null)
                {
                    <span class="badge bg-info text-dark">Cơ sở @facilityId</span>
                }
                else
                {
                    <span class="text-danger">(Chưa được gán cơ sở)</span>
                }
            </p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">🏢</div>
                    <h6 class="card-title text-info mt-1">Quản lý phòng</h6>
                    <p class="text-muted small">Xem lưới phòng trống / đang dùng / đóng bảo trì</p>
                    <a asp-controller="Rooms" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Xem sơ đồ phòng</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">📋</div>
                    <h6 class="card-title text-info mt-1">Duyệt đổi phòng/ca</h6>
                    <p class="text-muted small">Xét duyệt yêu cầu của giảng viên tại cơ sở</p>
                    <a asp-controller="ChangeRequests" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Xem yêu cầu</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-info shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">👤</div>
                    <h6 class="card-title text-info mt-1">Điểm danh</h6>
                    <p class="text-muted small">Theo dõi điểm danh tại cơ sở</p>
                    <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-info w-100">Xem điểm danh</a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-hammer me-2"></i>
        <strong>Dev A đang hoàn thiện.</strong> Số liệu thống kê cơ sở (phòng trống, lớp đang dạy, doanh thu...) sẽ hiện ở đây.
    </div>
</div>
