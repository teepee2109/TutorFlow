@model FrontEnd.Models.EnrollmentsPageViewModel
@{
    ViewData["Title"] = "Ghi danh học viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">📝 Ghi danh học viên</h2>
        <p class="text-muted mb-0">Kiểm tra lịch trùng trước khi ghi danh hoặc ghi danh lại.</p>
    </div>
    <a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Student" class="btn btn-outline-primary">Quản lý tài khoản học viên</a>
</div>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
@if (ViewBag.OptionsErrorMessage is string optionsError) { <div class="alert alert-danger">Không tải được dữ liệu lựa chọn: @optionsError</div> }
@if (ViewBag.ErrorMessage is string loadError) { <div class="alert alert-danger">@loadError</div> }

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Tạo ghi danh / ghi danh lại</div>
    <div class="card-body">
        <form method="post" asp-action="Preview" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label" for="studentId">Học viên</label>
                <select id="studentId" name="Form.StudentId" class="form-select" required>
                    <option value="0">-- Chọn học viên --</option>
                    @foreach (var student in Model.Options.Students)
                    {
                        <option value="@student.StudentId" selected="@(student.StudentId == Model.Form.StudentId ? "selected" : null)">@student.FullName · @student.Email</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="classId">Lớp đang hoạt động</label>
                <select id="classId" name="Form.ClassId" class="form-select" required>
                    <option value="0">-- Chọn lớp --</option>
                    @foreach (var item in Model.Options.Classes)
                    {
                        <option value="@item.ClassId" selected="@(item.ClassId == Model.Form.ClassId ? "selected" : null)">@item.ClassName · @item.SubjectName · GV @item.LecturerName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="enrollDate">Ngày ghi danh</label>
                <input id="enrollDate" name="Form.EnrollDate" type="date" value="@Model.Form.EnrollDate.ToString("yyyy-MM-dd")" class="form-control" required />
            </div>
            <div class="col-md-1 d-grid"><button class="btn btn-primary" type="submit">Kiểm tra</button></div>
        </form>
    </div>
</div>

@if (Model.Preview != null)
{
    @if (Model.Preview.AlreadyEnrolled)
    {
        <div class="alert alert-info">Học viên đã ghi danh Active trong lớp này.</div>
    }
    else if (Model.Preview.Conflicts.Count > 0)
    {
        <div class="alert alert-warning"><strong>Không thể ghi danh do trùng lịch.</strong> Các buổi xung đột:</div>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-bordered bg-white">
                <thead><tr><th>Ngày</th><th>Ca</th><th>Lớp đang học</th></tr></thead>
                <tbody>
                    @foreach (var conflict in Model.Preview.Conflicts)
                    {
                        <tr><td>@conflict.Date.ToString("dd/MM/yyyy")</td><td>@conflict.ShiftName</td><td>@conflict.ConflictingClassName</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Preview.CanEnroll)
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center">
            <span>Không phát hiện ngày/ca bị trùng. Có thể ghi danh.</span>
            <form method="post" asp-action="Enroll" class="mb-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Form.StudentId" value="@Model.Form.StudentId" />
                <input type="hidden" name="Form.ClassId" value="@Model.Form.ClassId" />
                <input type="hidden" name="Form.EnrollDate" value="@Model.Form.EnrollDate.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-success">Xác nhận ghi danh</button>
            </form>
        </div>
    }
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Danh sách ghi danh</div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label" for="search">Tìm học viên hoặc lớp</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
            <div class="col-md-3">
                <label class="form-label" for="filterClass">Lớp</label>
                <select id="filterClass" name="classId" class="form-select"><option value="">Tất cả</option>
                    @foreach (var item in Model.Options.Classes) { <option value="@item.ClassId" selected="@(Model.ClassFilterId == item.ClassId ? "selected" : null)">@item.ClassName</option> }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label" for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="All" selected="@(Model.Status == "All" ? "selected" : null)">Tất cả</option><option value="Active" selected="@(Model.Status == "Active" ? "selected" : null)">Đang học</option><option value="Dropped" selected="@(Model.Status == "Dropped" ? "selected" : null)">Đã nghỉ</option></select></div>
            <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Lọc</button></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tf-paginated-table">
            <thead class="table-light"><tr><th>Học viên</th><th>Lớp</th><th>Ngày ghi danh</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                @if (Model.Enrollments.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu ghi danh.</td></tr> }
                @foreach (var enrollment in Model.Enrollments)
                {
                    <tr>
                        <td>@enrollment.StudentName<div class="small text-muted">@enrollment.StudentEmail</div></td>
                        <td>@enrollment.ClassName</td>
                        <td>@enrollment.EnrollDate.ToString("dd/MM/yyyy")</td>
                        <td>@if (enrollment.Status == "Active") { <span class="badge bg-success">Đang học</span> } else { <span class="badge bg-secondary">Đã nghỉ</span> }</td>
                        <td>
                            @if (enrollment.Status == "Active")
                            {
                                <form method="post" asp-action="Drop" onsubmit="return confirm('Xác nhận cho học viên nghỉ lớp này?')">
                                    @Html.AntiForgeryToken()<input type="hidden" name="enrollmentId" value="@enrollment.EnrollmentId" />
                                    <button class="btn btn-sm btn-outline-danger">Cho nghỉ</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Reactivate">
                                    @Html.AntiForgeryToken()<input type="hidden" name="studentId" value="@enrollment.StudentId" /><input type="hidden" name="classId" value="@enrollment.ClassId" />
                                    <button class="btn btn-sm btn-outline-primary">Ghi danh lại</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
