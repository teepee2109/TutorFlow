@model FrontEnd.Models.AttendanceRosterViewModel
@{
    ViewData["Title"] = "Điểm danh buổi học";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">@(User.IsInRole("Lecturer") ? "✅ Điểm danh" : "📋 Xem điểm danh") · @Model.ClassName</h2>
        <p class="text-muted mb-0">@Model.SessionDate.ToString("dd/MM/yyyy") · @Model.ShiftName · Phòng @Model.RoomNumber</p>
    </div>
    @if (User.IsInRole("Lecturer"))
    {
        <a asp-controller="Schedule" asp-action="Index" class="btn btn-outline-secondary">Quay lại lịch dạy</a>
    }
    else
    {
        <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
    }
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (ViewBag.ErrorMessage is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (TempData["ErrorMessage"] is string actionError)
{
    <div class="alert alert-danger">@actionError</div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        @if (Model.Status == "Completed")
        {
            <span class="badge bg-success">Buổi đã hoàn tất</span>
        }
        else
        {
            <span class="badge bg-primary">Buổi đang mở</span>
        }
        <span class="text-muted ms-2">@Model.Students.Count học viên đủ điều kiện điểm danh</span>
    </div>
    @if (User.IsInRole("Lecturer") && Model.Status != "Completed")
    {
        <form method="post" asp-action="Complete" onsubmit="return confirm('Đánh dấu buổi học này là đã hoàn tất?')">
            @Html.AntiForgeryToken()
            <input type="hidden" name="sessionId" value="@Model.SessionId" />
            <button class="btn btn-success" type="submit">Hoàn tất buổi học</button>
        </form>
    }
</div>

@if (User.IsInRole("Lecturer") && Model.Status != "Completed" && Model.Students.Count > 0)
{
    <div class="alert alert-info py-2 small">Cần lưu điểm danh cho toàn bộ học viên đủ điều kiện trước khi hoàn tất buổi học.</div>
}

<form method="post" asp-action="Save">
    @if (User.IsInRole("Lecturer"))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="SessionId" value="@Model.SessionId" />
    }
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 tf-paginated-table">
                <thead class="table-light"><tr><th>#</th><th>Học viên</th><th>Email</th><th>Trạng thái</th><th>Ghi chú</th></tr></thead>
                <tbody>
                    @if (Model.Students.Count == 0)
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">Lớp chưa có học viên Active đủ điều kiện điểm danh.</td></tr>
                    }
                    @for (var index = 0; index < Model.Students.Count; index++)
                    {
                        var student = Model.Students[index];
                        <tr>
                            <td>
                                @(index + 1)
                                @if (User.IsInRole("Lecturer"))
                                {
                                    <input type="hidden" name="Students[@index].StudentId" value="@student.StudentId" />
                                }
                            </td>
                            <td class="fw-semibold">@student.FullName</td>
                            <td>@student.Email</td>
                            <td>
                                @if (User.IsInRole("Lecturer") && Model.Status != "Completed")
                                {
                                    <select name="Students[@index].AttendanceStatus" class="form-select form-select-sm" required>
                                        <option value="">-- Chọn --</option>
                                        <option value="Present" selected="@(student.AttendanceStatus == "Present" ? "selected" : null)">Có mặt</option>
                                        <option value="ExcusedAbsent" selected="@(student.AttendanceStatus == "ExcusedAbsent" ? "selected" : null)">Vắng có phép</option>
                                        <option value="UnexcusedAbsent" selected="@(student.AttendanceStatus == "UnexcusedAbsent" ? "selected" : null)">Vắng không phép</option>
                                    </select>
                                }
                                else
                                {
                                    @switch (student.AttendanceStatus)
                                    {
                                        case "Present": <span class="badge text-bg-success">Có mặt</span> break;
                                        case "ExcusedAbsent": <span class="badge text-bg-warning">Vắng có phép</span> break;
                                        case "UnexcusedAbsent": <span class="badge text-bg-danger">Vắng không phép</span> break;
                                        default: <span class="text-muted">Chưa ghi nhận</span> break;
                                    }
                                }
                            </td>
                            <td>
                                @if (User.IsInRole("Lecturer") && Model.Status != "Completed")
                                {
                                    <input name="Students[@index].Note" value="@student.Note" maxlength="255" class="form-control form-control-sm" />
                                }
                                else
                                {
                                    @(string.IsNullOrWhiteSpace(student.Note) ? "—" : student.Note)
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-white d-flex justify-content-between align-items-center">
            @if (User.IsInRole("Lecturer") && Model.Status != "Completed")
            {
                <span class="small text-muted">Lưu sẽ thêm mới hoặc cập nhật các điểm danh đã có.</span>
                <button type="submit" class="btn btn-primary" @(Model.Students.Count == 0 ? "disabled" : null)>Lưu điểm danh</button>
            }
            else if (User.IsInRole("Lecturer"))
            {
                <span class="small text-muted">Buổi học đã hoàn tất. Điểm danh đã khóa, chỉ xem.</span>
            }
            else
            {
                <span class="small text-muted">Chế độ chỉ xem. Chỉ giảng viên phụ trách mới được sửa điểm danh.</span>
            }
        </div>
    </div>
</form>
