@model FrontEnd.Models.AdminDashboardViewModel
@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Dashboard cơ sở";
    var facilityId = Model.FacilityId ?? CurrentUser.FacilityId;
}

<div class="tf-page-heading">
    <div>
        <h1>Tổng quan cơ sở</h1>
        <p>Xin chào, <strong>@CurrentUser.FullName</strong> · @(Model.FacilityName ?? (facilityId.HasValue ? $"Cơ sở {facilityId}" : "Chưa được gán cơ sở"))</p>
    </div>
    <form method="get" asp-controller="FacilityManager" asp-action="Index" class="d-flex align-items-end gap-2">
        <div>
            <label class="form-label mb-1" for="dashboardDate">Ngày xem</label>
            <input id="dashboardDate" type="date" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Cập nhật</button>
    </form>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <section class="tf-stat-card primary" data-icon="⌂" aria-label="Cơ sở vật chất">
            <div class="tf-stat-label">Cơ sở vật chất</div>
            <div class="tf-stat-value">@(Model.TotalRooms ?? 0) <small class="fs-6 fw-normal">phòng</small></div>
            <div class="tf-stat-note">Đang mở: <strong>@(Model.OpenRooms ?? 0)</strong><span class="mx-2">·</span>Đóng: <strong>@(Model.ClosedRooms ?? 0)</strong></div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="tf-stat-card success" data-icon="▣" aria-label="Quy mô đào tạo">
            <div class="tf-stat-label">Quy mô đào tạo</div>
            <div class="tf-stat-value">@(Model.ActiveClasses ?? 0) <small class="fs-6 fw-normal">lớp đang mở</small></div>
            <div class="tf-stat-note">Giảng viên: <strong>@(Model.ActiveLecturers ?? 0)</strong><span class="mx-2">·</span>Học viên: <strong>@(Model.ActiveStudents ?? 0)</strong></div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="tf-stat-card warning" data-icon="₫" aria-label="Vận hành và tài chính">
            <div class="tf-stat-label">Vận hành &amp; tài chính</div>
            <div class="tf-stat-value">@(Model.PendingChangeRequests ?? 0) <small class="fs-6 fw-normal">yêu cầu chờ duyệt</small></div>
            <div class="tf-stat-note">Học phí chưa thu: <strong>@Model.TotalUnpaidTuition.ToString("N0") VNĐ</strong></div>
        </section>
    </div>
</div>

<partial name="_RoomShiftStatusTable" model="Model" />

<div class="row g-3 mt-1">
    <div class="col-md-4"><a asp-controller="Rooms" asp-action="Index" class="tf-quick-card"><span class="tf-quick-icon">⌂</span><strong>Quản lý phòng</strong><small>Xem phòng đang dùng, còn trống và bảo trì</small></a></div>
    <div class="col-md-4"><a asp-controller="ChangeRequests" asp-action="Index" class="tf-quick-card"><span class="tf-quick-icon">⇄</span><strong>Duyệt đổi phòng / ca</strong><small>Xem và xử lý yêu cầu tại cơ sở</small></a></div>
    <div class="col-md-4"><a asp-controller="Attendance" asp-action="Index" class="tf-quick-card"><span class="tf-quick-icon">✓</span><strong>Điểm danh</strong><small>Theo dõi tình hình điểm danh</small></a></div>
</div>
