@model FrontEnd.Models.EnrollmentsPageViewModel
@{
    ViewData["Title"] = "Ghi danh học viên";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">📝 Ghi danh học viên</h2>
        <p class="text-muted mb-0">Kiểm tra lịch trùng trước khi ghi danh hoặc ghi danh lại. Danh sách chỉ gồm lớp có buổi học tương lai đã được xếp lịch.</p>
    </div>
    <a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Student" class="btn btn-outline-primary">Quản lý tài khoản học viên</a>
</div>

@if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
@if (ViewBag.OptionsErrorMessage is string optionsError) { <div class="alert alert-danger">Không tải được dữ liệu lựa chọn: @optionsError</div> }
@if (ViewBag.ErrorMessage is string loadError) { <div class="alert alert-danger">@loadError</div> }

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Ghi danh nhanh nhiều học viên</div>
    <div class="card-body">
        <p class="text-muted">Chọn một lớp, đánh dấu nhiều học viên, xem trước xung đột rồi xác nhận một lần.</p>
        <form method="post" asp-action="BulkPreview" id="bulkEnrollmentForm">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-end mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="bulkClassId">Lớp đang hoạt động</label>
                    <select id="bulkClassId" name="BulkForm.ClassId" class="form-select" required disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)">
                        <option value="0">-- Chọn lớp --</option>
                        @foreach (var item in Model.Options.Classes)
                        {
                            <option value="@item.ClassId" selected="@(item.ClassId == Model.BulkForm.ClassId ? "selected" : null)">@item.ClassName · @item.SubjectName · GV @item.LecturerName</option>
                        }
                    </select>
                    <span asp-validation-for="BulkForm.ClassId" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="bulkEnrollDate">Ngày ghi danh</label>
                    <input id="bulkEnrollDate" name="BulkForm.EnrollDate" type="date" value="@Model.BulkForm.EnrollDate.ToString("yyyy-MM-dd")" class="form-control" required disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)" />
                    <span asp-validation-for="BulkForm.EnrollDate" class="text-danger small"></span>
                </div>
                <div class="col-md-3 text-muted small">Tối đa 100 học viên mỗi lần.</div>
            </div>

            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-2">
                <div class="flex-grow-1" style="max-width: 520px">
                    <label class="form-label" for="bulkStudentSearch">Tìm học viên</label>
                    <input id="bulkStudentSearch" type="search" class="form-control" placeholder="Nhập tên hoặc email" disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)" />
                </div>
                <div class="d-flex gap-2">
                    <button id="selectVisibleStudents" type="button" class="btn btn-outline-primary" disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)">Chọn kết quả đang lọc</button>
                    <button id="clearSelectedStudents" type="button" class="btn btn-outline-secondary" disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)">Bỏ chọn</button>
                </div>
            </div>
            <div id="bulkStudentList" class="border rounded p-2 mb-2" style="max-height: 260px; overflow-y: auto">
                @foreach (var student in Model.Options.Students)
                {
                    var selected = Model.BulkForm.StudentIds.Contains(student.StudentId);
                    <label class="bulk-student-option d-flex align-items-start gap-2 border-bottom py-2 px-1" data-search="@student.FullName @student.Email">
                        <input class="form-check-input bulk-student-checkbox mt-1" type="checkbox" name="BulkForm.StudentIds" value="@student.StudentId" checked="@(selected ? "checked" : null)" disabled="@(Model.BulkCheck != null || Model.BulkResult != null ? "disabled" : null)" />
                        <span><strong>@student.FullName</strong><span class="d-block text-muted small">@student.Email</span></span>
                    </label>
                }
                @if (Model.Options.Students.Count == 0)
                {
                    <div class="text-muted py-3">Không có học viên đang hoạt động.</div>
                }
            </div>
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="small text-muted" id="bulkSelectedCount">Đã chọn @Model.BulkForm.StudentIds.Count học viên.</span>
                @if (Model.BulkCheck != null || Model.BulkResult != null)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">Chọn danh sách khác</a>
                }
                else
                {
                    <button type="submit" class="btn btn-primary">Kiểm tra học viên đã chọn</button>
                }
            </div>
            <span asp-validation-for="BulkForm.StudentIds" class="text-danger small"></span>
        </form>
    </div>
</div>

@if (Model.BulkCheck != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Kết quả kiểm tra ghi danh</div>
        <div class="card-body">
            <div class="alert alert-info">Có thể ghi danh: <strong>@Model.BulkCheck.ReadyCount</strong> · Đã có trong lớp: <strong>@Model.BulkCheck.AlreadyEnrolledCount</strong> · Trùng lịch: <strong>@Model.BulkCheck.ConflictCount</strong> · Không hợp lệ: <strong>@Model.BulkCheck.FailedCount</strong></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle">
                    <thead><tr><th>Học viên</th><th>Kết quả</th><th>Chi tiết</th></tr></thead>
                    <tbody>
                        @foreach (var student in Model.BulkCheck.Students)
                        {
                            var badgeClass = student.Status == "Ready" ? "bg-success" : student.Status == "Conflict" ? "bg-warning text-dark" : student.Status == "AlreadyEnrolled" ? "bg-secondary" : "bg-danger";
                            var statusText = student.Status == "Ready" ? "Có thể ghi danh" : student.Status == "Conflict" ? "Trùng lịch" : student.Status == "AlreadyEnrolled" ? "Đã ghi danh" : "Không hợp lệ";
                            <tr>
                                <td>@student.StudentName</td>
                                <td><span class="badge @badgeClass">@statusText</span></td>
                                <td>
                                    @student.Message
                                    @if (student.Conflicts.Count > 0)
                                    {
                                        <ul class="mb-0 small">
                                            @foreach (var conflict in student.Conflicts)
                                            {
                                                <li>@conflict.Date.ToString("dd/MM/yyyy") · @conflict.ShiftName · @conflict.ConflictingClassName</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.BulkCheck.ReadyCount > 0)
            {
                <form method="post" asp-action="BulkEnroll" class="d-flex justify-content-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BulkForm.ClassId" value="@Model.BulkForm.ClassId" />
                    <input type="hidden" name="BulkForm.EnrollDate" value="@Model.BulkForm.EnrollDate.ToString("yyyy-MM-dd")" />
                    @foreach (var studentId in Model.BulkForm.StudentIds.Distinct())
                    {
                        <input type="hidden" name="BulkForm.StudentIds" value="@studentId" />
                    }
                    <button type="submit" class="btn btn-success">Xác nhận ghi danh @Model.BulkCheck.ReadyCount học viên</button>
                </form>
            }
            else
            {
                <div class="alert alert-warning mb-0">Không có học viên nào đủ điều kiện để ghi danh. Hãy điều chỉnh danh sách hoặc kiểm tra lịch học.</div>
            }
        </div>
    </div>
}

@if (Model.BulkResult != null)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Kết quả ghi danh hàng loạt</div>
        <div class="card-body">
            <div class="alert @(Model.BulkResult.EnrolledCount > 0 ? "alert-success" : "alert-warning")">Đã ghi danh: <strong>@Model.BulkResult.EnrolledCount</strong> · Đã có trong lớp: <strong>@Model.BulkResult.AlreadyEnrolledCount</strong> · Trùng lịch: <strong>@Model.BulkResult.ConflictCount</strong> · Không thành công: <strong>@Model.BulkResult.FailedCount</strong></div>
            <div class="table-responsive">
                <table class="table table-sm table-hover align-middle mb-0">
                    <thead><tr><th>Học viên</th><th>Kết quả</th><th>Chi tiết</th></tr></thead>
                    <tbody>
                        @foreach (var student in Model.BulkResult.Students)
                        {
                            var badgeClass = student.Status == "Enrolled" ? "bg-success" : student.Status == "Conflict" ? "bg-warning text-dark" : student.Status == "AlreadyEnrolled" ? "bg-secondary" : "bg-danger";
                            var statusText = student.Status == "Enrolled" ? "Đã ghi danh" : student.Status == "Conflict" ? "Trùng lịch" : student.Status == "AlreadyEnrolled" ? "Đã ghi danh" : "Không thành công";
                            <tr>
                                <td>@student.StudentName</td>
                                <td><span class="badge @badgeClass">@statusText</span></td>
                                <td>
                                    @student.Message
                                    @if (student.Conflicts.Count > 0)
                                    {
                                        <ul class="mb-0 small">
                                            @foreach (var conflict in student.Conflicts)
                                            {
                                                <li>@conflict.Date.ToString("dd/MM/yyyy") · @conflict.ShiftName · @conflict.ConflictingClassName</li>
                                            }
                                        </ul>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Tạo ghi danh / ghi danh lại</div>
    <div class="card-body">
        <form method="post" asp-action="Preview" class="row g-3 align-items-end">
            @Html.AntiForgeryToken()
            <div class="col-md-5">
                <label class="form-label" for="studentId">Học viên</label>
                <select id="studentId" name="Form.StudentId" class="form-select" required>
                    <option value="0">-- Chọn học viên --</option>
                    @foreach (var student in Model.Options.Students)
                    {
                        <option value="@student.StudentId" selected="@(student.StudentId == Model.Form.StudentId ? "selected" : null)">@student.FullName · @student.Email</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label" for="classId">Lớp đang hoạt động</label>
                <select id="classId" name="Form.ClassId" class="form-select" required>
                    <option value="0">-- Chọn lớp --</option>
                    @foreach (var item in Model.Options.Classes)
                    {
                        <option value="@item.ClassId" selected="@(item.ClassId == Model.Form.ClassId ? "selected" : null)">@item.ClassName · @item.SubjectName · GV @item.LecturerName</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label" for="enrollDate">Ngày ghi danh</label>
                <input id="enrollDate" name="Form.EnrollDate" type="date" value="@Model.Form.EnrollDate.ToString("yyyy-MM-dd")" class="form-control" required />
            </div>
            <div class="col-md-1 d-grid"><button class="btn btn-primary" type="submit">Kiểm tra</button></div>
        </form>
    </div>
</div>

@if (Model.Preview != null)
{
    @if (Model.Preview.AlreadyEnrolled)
    {
        <div class="alert alert-info">Học viên đã ghi danh Active trong lớp này.</div>
    }
    else if (Model.Preview.Conflicts.Count > 0)
    {
        <div class="alert alert-warning"><strong>Không thể ghi danh do trùng lịch.</strong> Các buổi xung đột:</div>
        <div class="table-responsive mb-4">
            <table class="table table-sm table-bordered bg-white">
                <thead><tr><th>Ngày</th><th>Ca</th><th>Lớp đang học</th></tr></thead>
                <tbody>
                    @foreach (var conflict in Model.Preview.Conflicts)
                    {
                        <tr><td>@conflict.Date.ToString("dd/MM/yyyy")</td><td>@conflict.ShiftName</td><td>@conflict.ConflictingClassName</td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else if (Model.Preview.CanEnroll)
    {
        <div class="alert alert-success d-flex justify-content-between align-items-center">
            <span>Không phát hiện ngày/ca bị trùng. Có thể ghi danh.</span>
            <form method="post" asp-action="Enroll" class="mb-0">
                @Html.AntiForgeryToken()
                <input type="hidden" name="Form.StudentId" value="@Model.Form.StudentId" />
                <input type="hidden" name="Form.ClassId" value="@Model.Form.ClassId" />
                <input type="hidden" name="Form.EnrollDate" value="@Model.Form.EnrollDate.ToString("yyyy-MM-dd")" />
                <button type="submit" class="btn btn-success">Xác nhận ghi danh</button>
            </form>
        </div>
    }
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Danh sách ghi danh</div>
    <div class="card-body border-bottom">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-5"><label class="form-label" for="search">Tìm học viên hoặc lớp</label><input id="search" name="search" value="@Model.Search" class="form-control" /></div>
            <div class="col-md-3">
                <label class="form-label" for="filterClass">Lớp</label>
                <select id="filterClass" name="classId" class="form-select"><option value="">Tất cả</option>
                    @foreach (var item in Model.Options.Classes) { <option value="@item.ClassId" selected="@(Model.ClassFilterId == item.ClassId ? "selected" : null)">@item.ClassName</option> }
                </select>
            </div>
            <div class="col-md-2"><label class="form-label" for="status">Trạng thái</label><select id="status" name="status" class="form-select"><option value="All" selected="@(Model.Status == "All" ? "selected" : null)">Tất cả</option><option value="Active" selected="@(Model.Status == "Active" ? "selected" : null)">Đang học</option><option value="Dropped" selected="@(Model.Status == "Dropped" ? "selected" : null)">Đã nghỉ</option></select></div>
            <div class="col-md-2 d-grid"><button class="btn btn-outline-primary">Lọc</button></div>
        </form>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tf-paginated-table">
            <thead class="table-light"><tr><th>Học viên</th><th>Lớp</th><th>Ngày ghi danh</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                @if (Model.Enrollments.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-4">Chưa có dữ liệu ghi danh.</td></tr> }
                @foreach (var enrollment in Model.Enrollments)
                {
                    <tr>
                        <td>@enrollment.StudentName<div class="small text-muted">@enrollment.StudentEmail</div></td>
                        <td>@enrollment.ClassName</td>
                        <td>@enrollment.EnrollDate.ToString("dd/MM/yyyy")</td>
                        <td>@if (enrollment.Status == "Active") { <span class="badge bg-success">Đang học</span> } else { <span class="badge bg-secondary">Đã nghỉ</span> }</td>
                        <td>
                            @if (enrollment.Status == "Active")
                            {
                                <form method="post" asp-action="Drop" onsubmit="return confirm('Xác nhận cho học viên nghỉ lớp này?')">
                                    @Html.AntiForgeryToken()<input type="hidden" name="enrollmentId" value="@enrollment.EnrollmentId" />
                                    <button class="btn btn-sm btn-outline-danger">Cho nghỉ</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-action="Reactivate">
                                    @Html.AntiForgeryToken()<input type="hidden" name="studentId" value="@enrollment.StudentId" /><input type="hidden" name="classId" value="@enrollment.ClassId" />
                                    <button class="btn btn-sm btn-outline-primary">Ghi danh lại</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById("bulkStudentSearch");
            const list = document.getElementById("bulkStudentList");
            const count = document.getElementById("bulkSelectedCount");
            if (!search || !list || !count) return;

            const options = Array.from(list.querySelectorAll(".bulk-student-option"));
            const checkboxes = Array.from(list.querySelectorAll(".bulk-student-checkbox"));
            const updateCount = () => {
                const selected = checkboxes.filter(item => item.checked).length;
                count.textContent = "Đã chọn " + selected + " học viên.";
            };

            search.addEventListener("input", () => {
                const query = search.value.trim().toLocaleLowerCase("vi");
                options.forEach(option => {
                    const hidden = !option.dataset.search.toLocaleLowerCase("vi").includes(query);
                    option.hidden = hidden;
                    if (hidden) option.style.setProperty("display", "none", "important");
                    else option.style.removeProperty("display");
                });
            });

            document.getElementById("selectVisibleStudents")?.addEventListener("click", () => {
                options.forEach(option => {
                    if (!option.hidden) option.querySelector(".bulk-student-checkbox").checked = true;
                });
                updateCount();
            });

            document.getElementById("clearSelectedStudents")?.addEventListener("click", () => {
                checkboxes.forEach(item => item.checked = false);
                updateCount();
            });

            checkboxes.forEach(item => item.addEventListener("change", updateCount));
        })();
    </script>
}
