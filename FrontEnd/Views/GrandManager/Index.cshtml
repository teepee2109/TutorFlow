@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Dashboard quản lý tổng";
}

<div class="tf-page-heading">
    <div>
        <h1>Xin chào, @CurrentUser.FullName</h1>
        <p>Quản lý hoạt động đào tạo, ghi danh và học phí của TutorFlow.</p>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <article class="tf-action-card">
            <span class="tf-action-icon">▣</span><h2>Lớp học</h2>
            <p>Tạo lớp, xem danh sách và quản lý các buổi học.</p>
            <a asp-controller="Classes" asp-action="Index" class="btn btn-primary w-100">Mở danh sách lớp</a>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="tf-action-card">
            <span class="tf-action-icon">＋</span><h2>Ghi danh</h2>
            <p>Thêm học viên vào lớp và theo dõi ghi danh.</p>
            <a asp-controller="Enrollments" asp-action="Index" class="btn btn-primary w-100">Quản lý ghi danh</a>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="tf-action-card">
            <span class="tf-action-icon">♙</span><h2>Tài khoản</h2>
            <p>Quản lý giảng viên, học viên và quản lý cơ sở.</p>
            <a asp-controller="Users" asp-action="Index" class="btn btn-outline-primary w-100">Quản lý tài khoản</a>
        </article>
    </div>
    <div class="col-sm-6 col-xl-3">
        <article class="tf-action-card">
            <span class="tf-action-icon">₫</span><h2>Học phí</h2>
            <p>Xem các khoản cần thu và ghi nhận thanh toán.</p>
            <a asp-controller="Tuitions" asp-action="Index" class="btn btn-outline-primary w-100">Quản lý học phí</a>
        </article>
    </div>
</div>

<div class="alert alert-info d-flex align-items-start gap-2" role="status">
    <span aria-hidden="true">ⓘ</span>
    <div><strong>Tổng quan thống kê</strong><br />Số liệu tổng hợp sẽ hiển thị tại đây khi API dashboard được kết nối.</div>
</div>
