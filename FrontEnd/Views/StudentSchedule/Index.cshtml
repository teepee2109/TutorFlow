@model FrontEnd.Models.StudentSchedulePageViewModel
@{
    ViewData["Title"] = "Lịch học của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div><h2 class="fw-bold mb-1">📚 Lịch học & điểm danh</h2><p class="text-muted mb-0">Chỉ hiển thị các lớp bạn đã ghi danh.</p></div>
    <form method="get" class="d-flex align-items-end gap-2">
        <div><label class="form-label" for="from">Từ ngày</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <div><label class="form-label" for="to">Đến ngày</label><input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" /></div>
        <button class="btn btn-primary">Xem</button>
    </form>
</div>
@if (ViewBag.ErrorMessage is string error) { <div class="alert alert-danger">@error</div> }
<div class="card border-0 shadow-sm"><div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Ngày / ca</th><th>Lớp</th><th>Phòng</th><th>Giảng viên</th><th>Buổi học</th><th>Điểm danh</th></tr></thead>
        <tbody>
            @if (Model.Sessions.Count == 0) { <tr><td colspan="6" class="text-center text-muted py-5">Không có buổi học trong khoảng thời gian này.</td></tr> }
            @foreach (var item in Model.Sessions)
            {
                <tr>
                    <td>@item.SessionDate.ToString("dd/MM/yyyy")<div class="small text-muted">@item.ShiftName · @item.StartTime.ToString("HH:mm")–@item.EndTime.ToString("HH:mm")</div></td>
                    <td class="fw-semibold">@item.ClassName</td><td>@item.RoomNumber<div class="small text-muted">@item.FacilityName</div></td><td>@item.LecturerName</td>
                    <td>@if (item.SessionStatus == "Completed") { <span class="badge bg-success">Đã hoàn tất</span> } else if (item.SessionStatus == "Cancelled") { <span class="badge bg-secondary">Đã hủy</span> } else { <span class="badge bg-primary">Sắp diễn ra</span> }</td>
                    <td>@(item.AttendanceStatus switch { "Present" => "Có mặt", "ExcusedAbsent" => "Vắng có phép", "UnexcusedAbsent" => "Vắng không phép", _ => "Chưa ghi nhận" })@if (!string.IsNullOrWhiteSpace(item.AttendanceNote)) { <div class="small text-muted">@item.AttendanceNote</div> }</td>
                </tr>
            }
        </tbody>
    </table>
</div></div>
