<Project Sdk="Microsoft.NET.Sdk.Web">
  <ItemGroup>
    <ProjectReference Include="BusinessObjects\TutorFlow.Data\TutorFlow.Data.csproj" />
    <ProjectReference Include="Services\TutorFlow.Services\TutorFlow.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="BusinessObjects\**\*.cs" />
    <Compile Remove="Services\**\*.cs" />
    <Compile Remove="Tests\**\*.cs" />
    <None Include="BusinessObjects\**\*.cs" Link="BusinessObjects\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="Services\**\*.cs" Link="Services\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
</Project>
