@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard quản trị";
}

<div class="tf-page-heading">
    <div>
        <h1>Tổng quan hệ thống</h1>
        <p>Theo dõi hoạt động TutorFlow và truy cập nhanh các chức năng quản trị.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Users" asp-action="Index" class="btn btn-primary">Quản lý tài khoản</a>
        <a asp-controller="Users" asp-action="Facilities" class="btn btn-outline-primary">Phân công cơ sở</a>
    </div>
</div>

<form method="get" asp-controller="Admin" asp-action="Index" class="card card-body mb-4">
    <div class="d-flex flex-wrap align-items-end gap-3">
        <div>
            <label class="form-label mb-1" for="dashboardDate">Ngày xem sơ đồ phòng</label>
            <input id="dashboardDate" type="date" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Xem ngày</button>
    </div>
</form>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger" role="alert">@ViewBag.ErrorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <section class="tf-stat-card primary" data-icon="⌂" aria-label="Cơ sở vật chất">
            <div class="tf-stat-label">Cơ sở vật chất</div>
            <div class="tf-stat-value">@(Model?.TotalRooms ?? 0) <small class="fs-6 fw-normal">phòng</small></div>
            <div class="tf-stat-note">Đang mở: <strong>@(Model?.OpenRooms ?? 0)</strong><span class="mx-2">·</span>Đóng bảo trì: <strong>@(Model?.ClosedRooms ?? 0)</strong></div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="tf-stat-card success" data-icon="▣" aria-label="Quy mô đào tạo">
            <div class="tf-stat-label">Quy mô đào tạo</div>
            <div class="tf-stat-value">@(Model?.ActiveClasses ?? 0) <small class="fs-6 fw-normal">lớp đang mở</small></div>
            <div class="tf-stat-note">Giảng viên: <strong>@(Model?.ActiveLecturers ?? 0)</strong><span class="mx-2">·</span>Học viên: <strong>@(Model?.ActiveStudents ?? 0)</strong></div>
        </section>
    </div>
    <div class="col-md-4">
        <section class="tf-stat-card warning" data-icon="₫" aria-label="Vận hành và tài chính">
            <div class="tf-stat-label">Vận hành &amp; tài chính</div>
            <div class="tf-stat-value">@(Model?.PendingChangeRequests ?? 0) <small class="fs-6 fw-normal">yêu cầu chờ duyệt</small></div>
            <div class="tf-stat-note">Học phí chưa thu: <strong>@(Model?.TotalUnpaidTuition.ToString("N0") ?? "0") VNĐ</strong></div>
        </section>
    </div>
</div>

<partial name="_RoomShiftStatusTable" model="Model" />

<section class="card mt-4">
    <div class="card-header">Lối tắt quản trị</div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-sm-6 col-xl-3"><a asp-controller="Users" asp-action="Create" class="tf-quick-card"><span class="tf-quick-icon">＋</span><strong>Thêm tài khoản</strong><small>Tạo tài khoản và phân vai trò</small></a></div>
            <div class="col-sm-6 col-xl-3"><a asp-controller="Users" asp-action="Facilities" class="tf-quick-card"><span class="tf-quick-icon">⌂</span><strong>Phân công cơ sở</strong><small>Gán người phụ trách cơ sở</small></a></div>
            <div class="col-sm-6 col-xl-3"><a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Lecturer" class="tf-quick-card"><span class="tf-quick-icon">♙</span><strong>Giảng viên</strong><small>Xem và quản lý tài khoản</small></a></div>
            <div class="col-sm-6 col-xl-3"><a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Student" class="tf-quick-card"><span class="tf-quick-icon">♧</span><strong>Học viên</strong><small>Xem và quản lý tài khoản</small></a></div>
        </div>
    </div>
</section>
