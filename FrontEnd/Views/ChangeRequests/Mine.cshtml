@model FrontEnd.Models.LecturerRoomChangeRequestListViewModel
@{
    ViewData["Title"] = "Yêu cầu đổi phòng/ca của tôi";
}

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">📋 Yêu cầu đổi phòng/ca của tôi</h2>
        <p class="text-muted mb-0">Theo dõi trạng thái xử lý và phản hồi của Facility Manager.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Gửi yêu cầu mới</a>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (ViewBag.ErrorMessage is string loadError)
{
    <div class="alert alert-danger">@loadError</div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 tf-paginated-table">
            <thead class="table-light"><tr><th>Gửi lúc</th><th>Lớp / phạm vi</th><th>Thay đổi yêu cầu</th><th>Lý do</th><th>Trạng thái / phản hồi</th></tr></thead>
            <tbody>
                @if (Model.Requests.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Bạn chưa gửi yêu cầu nào.</td></tr>
                }
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td>@request.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><strong>@request.ClassName</strong><div class="small text-muted">@request.Scope@if (request.SessionDate.HasValue)
                                {
                                    <text> · @request.SessionDate.Value.ToString("dd/MM/yyyy")</text>
                                }</div></td>
                        <td>
                            <div>Phòng: @request.CurrentRoom → @(request.RequestedRoom ?? "Giữ nguyên")</div>
                            <div class="small text-muted">Ca: @request.CurrentShift → @(request.RequestedShift ?? "Giữ nguyên")</div>
                        </td>
                        <td>@request.Reason</td>
                        <td>
                            @if (request.Status == "Approved")
                            {
                                <span class="badge bg-success">Đã duyệt</span>
                            }
                            else if (request.Status == "Rejected")
                            {
                                <span class="badge bg-danger">Từ chối</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chờ duyệt</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(request.ReviewNote))
                            {
                                <div class="small mt-1">@request.ReviewNote</div>
                            }
                            @if (request.ReviewedAt.HasValue)
                            {
                                <div class="small text-muted">@request.ReviewedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
