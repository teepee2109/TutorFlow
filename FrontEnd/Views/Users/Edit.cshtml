@model TutorFlow.Web.Models.UserEditViewModel
@{
    ViewData["Title"] = "Chỉnh sửa tài khoản";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h3 class="fw-bold mb-1">✏️ Chỉnh sửa thông tin</h3>
                        <p class="text-muted mb-0">Cập nhật họ tên, SĐT hoặc thay đổi vai trò tài khoản</p>
                    </div>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-outline-secondary btn-sm">⬅️ Quay lại</a>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger pb-0">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <form asp-controller="Users" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserId" />

                    <div class="mb-3">
                        <label class="form-label text-muted">Email (Không thể thay đổi)</label>
                        <input type="text" class="form-control bg-light" value="@Model.Email" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label">Họ và Tên <span class="text-danger">*</span></label>
                        <input asp-for="FullName" class="form-control" autofocus />
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                            <input asp-for="PhoneNumber" class="form-control" />
                            <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="RoleId" class="form-label">Vai trò <span class="text-danger">*</span></label>
                            <select asp-for="RoleId" asp-items="Model.RolesSelectList" class="form-select"></select>
                            <span asp-validation-for="RoleId" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-3">
                        <a asp-controller="Users" asp-action="Index" class="btn btn-light">Hủy</a>
                        <button type="submit" class="btn btn-primary px-4">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
