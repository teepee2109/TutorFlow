@inject ICurrentUser CurrentUser
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string controller, string? action = null) =>
        string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action == null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active"
            : string.Empty;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TutorFlow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FrontEnd.styles.css" asp-append-version="true" />
</head>
<body>
    @if (CurrentUser.IsAuthenticated)
    {
        <div class="tf-app-shell">
            <aside class="offcanvas offcanvas-start tf-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="sidebarLabel">
                <div class="tf-sidebar-header">
                    <a class="tf-brand" asp-controller="Home" asp-action="Index" id="sidebarLabel">
                        <span class="tf-brand-mark">T</span>
                        <span>Tutor<span class="tf-brand-light">Flow</span><small>QUẢN LÝ TRUNG TÂM</small></span>
                    </a>
                    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Đóng menu"></button>
                </div>

                <div class="tf-sidebar-user">
                    <span class="tf-avatar">@((CurrentUser.FullName?.FirstOrDefault() ?? 'U').ToString().ToUpperInvariant())</span>
                    <span class="tf-user-label"><strong>@CurrentUser.FullName</strong><small>@CurrentUser.Role</small></span>
                </div>

                <nav class="tf-nav" aria-label="Điều hướng chính">
                    <span class="tf-nav-heading">KHÔNG GIAN LÀM VIỆC</span>
                    @if (CurrentUser.IsInRole("Admin"))
                    {
                        <a class="tf-nav-link @Active("Admin")" asp-controller="Admin" asp-action="Index"><span class="tf-nav-icon">▦</span>Dashboard</a>
                        <a class="tf-nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><span class="tf-nav-icon">♙</span>Quản lý tài khoản</a>
                        <a class="tf-nav-link @Active("Users", "Facilities")" asp-controller="Users" asp-action="Facilities"><span class="tf-nav-icon">⌂</span>Cơ sở &amp; quản lý</a>
                        <a class="tf-nav-link @Active("Rooms")" asp-controller="Rooms" asp-action="Index"><span class="tf-nav-icon">▤</span>Lưới phòng</a>
                        <a class="tf-nav-link @Active("Tuitions")" asp-controller="Tuitions" asp-action="Index"><span class="tf-nav-icon">₫</span>Học phí</a>
                    }
                    @if (CurrentUser.IsInRole("GrandManager"))
                    {
                        <a class="tf-nav-link @Active("GrandManager")" asp-controller="GrandManager" asp-action="Index"><span class="tf-nav-icon">▦</span>Dashboard</a>
                        <a class="tf-nav-link @Active("Classes")" asp-controller="Classes" asp-action="Index"><span class="tf-nav-icon">▣</span>Lớp &amp; buổi học</a>
                        <a class="tf-nav-link @Active("Enrollments")" asp-controller="Enrollments" asp-action="Index"><span class="tf-nav-icon">＋</span>Ghi danh</a>
                        <a class="tf-nav-link @Active("Users")" asp-controller="Users" asp-action="Index"><span class="tf-nav-icon">♙</span>Tài khoản</a>
                        <a class="tf-nav-link @Active("Rooms")" asp-controller="Rooms" asp-action="Index"><span class="tf-nav-icon">▤</span>Lưới phòng</a>
                        <a class="tf-nav-link @Active("Tuitions")" asp-controller="Tuitions" asp-action="Index"><span class="tf-nav-icon">₫</span>Học phí</a>
                    }
                    @if (CurrentUser.IsInRole("FacilityManager"))
                    {
                        <a class="tf-nav-link @Active("FacilityManager")" asp-controller="FacilityManager" asp-action="Index"><span class="tf-nav-icon">▦</span>Dashboard</a>
                        <a class="tf-nav-link @Active("Rooms")" asp-controller="Rooms" asp-action="Index"><span class="tf-nav-icon">▤</span>Lưới phòng &amp; ca</a>
                        <a class="tf-nav-link @Active("ChangeRequests")" asp-controller="ChangeRequests" asp-action="Index"><span class="tf-nav-icon">⇄</span>Duyệt đổi phòng</a>
                        <a class="tf-nav-link @Active("Attendance")" asp-controller="Attendance" asp-action="Index"><span class="tf-nav-icon">✓</span>Điểm danh</a>
                    }
                    @if (CurrentUser.IsInRole("Lecturer"))
                    {
                        <a class="tf-nav-link @Active("Schedule")" asp-controller="Schedule" asp-action="Index"><span class="tf-nav-icon">▦</span>Lịch dạy &amp; điểm danh</a>
                        <a class="tf-nav-link @Active("Tuitions")" asp-controller="Tuitions" asp-action="Index"><span class="tf-nav-icon">₫</span>Học phí lớp tôi dạy</a>
                        <a class="tf-nav-link @Active("ChangeRequests", "Mine")" asp-controller="ChangeRequests" asp-action="Mine"><span class="tf-nav-icon">⇄</span>Yêu cầu của tôi</a>
                        <a class="tf-nav-link @Active("ChangeRequests", "Create")" asp-controller="ChangeRequests" asp-action="Create"><span class="tf-nav-icon">＋</span>Xin đổi phòng / ca</a>
                    }
                    @if (CurrentUser.IsInRole("Student"))
                    {
                        <a class="tf-nav-link @Active("StudentSchedule")" asp-controller="StudentSchedule" asp-action="Index"><span class="tf-nav-icon">▦</span>Lịch học</a>
                        <a class="tf-nav-link @Active("StudentTuition")" asp-controller="StudentTuition" asp-action="Index"><span class="tf-nav-icon">₫</span>Học phí của tôi</a>
                    }
                </nav>

                <div class="tf-sidebar-footer">
                    @if (CurrentUser.FacilityId.HasValue)
                    {
                        <div class="tf-facility-chip"><span class="tf-status-dot"></span>Cơ sở @CurrentUser.FacilityId</div>
                    }
                    <form method="post" asp-controller="Account" asp-action="Logout">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="tf-logout"><span class="tf-nav-icon">↪</span>Đăng xuất</button>
                    </form>
                </div>
            </aside>

            <div class="tf-main-shell">
                <header class="tf-topbar">
                    <button class="tf-menu-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Mở menu">☰</button>
                    <div class="tf-topbar-title"><span>TRANG HIỆN TẠI</span><strong>@ViewData["Title"]</strong></div>
                    <div class="tf-topbar-meta">
                        @if (CurrentUser.FacilityId.HasValue)
                        {
                            <span class="tf-topbar-facility">Cơ sở @CurrentUser.FacilityId</span>
                        }
                        <div class="dropdown">
                            <button class="tf-profile-button dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <span class="tf-avatar tf-avatar-small">@((CurrentUser.FullName?.FirstOrDefault() ?? 'U').ToString().ToUpperInvariant())</span>
                                <span class="d-none d-sm-block"><strong>@CurrentUser.FullName</strong><small>@CurrentUser.Role</small></span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                                <li><span class="dropdown-item-text small text-muted">@CurrentUser.Email</span></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Trang chủ</a></li>
                            </ul>
                        </div>
                    </div>
                </header>
                <main role="main" class="tf-content">
                    @RenderBody()
                </main>
                <footer class="tf-footer">© 2026 <strong>TutorFlow</strong><span>Hệ thống quản lý trung tâm dạy thêm</span></footer>
            </div>
        </div>
    }
    else
    {
        <div class="tf-public-shell">
            <header class="tf-public-topbar">
                <a class="tf-public-brand" asp-controller="Home" asp-action="Index"><span class="tf-brand-mark">T</span>Tutor<span>Flow</span></a>
                <a class="btn btn-primary" asp-controller="Account" asp-action="Login">Đăng nhập</a>
            </header>
            <main role="main" class="tf-public-content">@RenderBody()</main>
            <footer class="tf-footer">© 2026 <strong>TutorFlow</strong><span>Hệ thống quản lý trung tâm dạy thêm</span></footer>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
