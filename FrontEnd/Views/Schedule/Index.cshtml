@model FrontEnd.Models.LecturerScheduleViewModel
@{
    ViewData["Title"] = "Lịch dạy của tôi";
    var previousWeek = Model.From.AddDays(-7);
    var nextWeek = Model.From.AddDays(7);
    var today = DateOnly.FromDateTime(DateTime.Today);
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">📅 Lịch dạy của tôi</h2>
        <p class="text-muted mb-0">Các buổi được phân công cho tài khoản giảng viên đang đăng nhập.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-from="@previousWeek" class="btn btn-outline-secondary">← Tuần trước</a>
        <a asp-action="Index" class="btn btn-outline-primary">Tuần này</a>
        <a asp-action="Index" asp-route-from="@nextWeek" class="btn btn-outline-secondary">Tuần sau →</a>
        <form method="get" asp-action="Index" class="d-flex gap-2">
            <input type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")" class="form-control" aria-label="Từ ngày" />
            <input type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")" class="form-control" aria-label="Đến ngày" />
            <button class="btn btn-primary" type="submit">Xem</button>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (ViewBag.ErrorMessage is string loadError)
{
    <div class="alert alert-danger">@loadError</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">@Model.From.ToString("dd/MM/yyyy") – @Model.To.ToString("dd/MM/yyyy")</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>Ngày / ca</th><th>Lớp</th><th>Phòng</th><th>Trạng thái</th><th>Thao tác</th></tr></thead>
            <tbody>
                @if (Model.Sessions.Count == 0)
                {
                    <tr><td colspan="5" class="text-center text-muted py-5">Không có buổi dạy trong khoảng ngày này.</td></tr>
                }
                @foreach (var session in Model.Sessions)
                {
                    <tr>
                        <td>@session.SessionDate.ToString("dd/MM/yyyy")<div class="small text-muted">@session.ShiftName · @session.StartTime.ToString("HH:mm")–@session.EndTime.ToString("HH:mm")</div></td>
                        <td class="fw-semibold">@session.ClassName</td>
                        <td>@session.RoomNumber<div class="small text-muted">@session.FacilityName</div></td>
                        <td>
                            @if (session.Status == "Completed")
                            {
                                <span class="badge bg-success">Đã hoàn tất</span>
                            }
                            else if (session.Status == "Cancelled")
                            {
                                <span class="badge bg-secondary">Đã hủy</span>
                            }
                            else
                            {
                                <span class="badge bg-primary">Scheduled</span>
                            }
                        </td>
                        <td>
                            @if (session.Status != "Cancelled" && session.SessionDate <= today)
                            {
                                <a asp-controller="Attendance" asp-action="Index" asp-route-sessionId="@session.SessionId" class="btn btn-sm btn-outline-primary">@(session.Status == "Completed" ? "Xem / sửa điểm danh" : "Điểm danh")</a>
                            }
                            @if (session.Status == "Scheduled" && session.SessionDate >= today)
                            {
                                <a asp-controller="ChangeRequests" asp-action="Create" asp-route-sessionId="@session.SessionId" class="btn btn-sm btn-outline-warning">Xin đổi phòng / ca</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
