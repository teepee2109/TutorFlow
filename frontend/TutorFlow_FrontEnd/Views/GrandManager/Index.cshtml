@using TutorFlow.Services.Common
@inject ICurrentUser CurrentUser
@{
    ViewData["Title"] = "Grand Manager Dashboard";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h4 class="mb-1"><i class="bi bi-speedometer2 me-2 text-success"></i>Grand Manager Dashboard</h4>
            <p class="text-muted mb-0">Xin chào, <strong>@CurrentUser.FullName</strong> — Quản lý toàn hệ thống TutorFlow.</p>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">📚</div>
                    <h6 class="card-title text-success mt-1">Lớp học</h6>
                    <p class="text-muted small">Tạo và quản lý lớp học</p>
                    <a asp-controller="Classes" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Xem danh sách</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">📝</div>
                    <h6 class="card-title text-success mt-1">Ghi danh</h6>
                    <p class="text-muted small">Ghi danh học viên vào lớp</p>
                    <a asp-controller="Enrollments" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Quản lý</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">👥</div>
                    <h6 class="card-title text-success mt-1">Tài khoản</h6>
                    <p class="text-muted small">Quản lý FM, Giảng viên, Học viên</p>
                    <a asp-controller="Users" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Quản lý</a>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-success shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="fs-1">💰</div>
                    <h6 class="card-title text-success mt-1">Học phí</h6>
                    <p class="text-muted small">Xem và ghi nhận thanh toán</p>
                    <a asp-controller="Tuitions" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Quản lý</a>
                </div>
            </div>
        </div>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-hammer me-2"></i>
        <strong>Dev A đang hoàn thiện.</strong> Số liệu thống kê tổng hợp (số lớp, học viên, doanh thu...) sẽ hiện ở đây.
    </div>
</div>
