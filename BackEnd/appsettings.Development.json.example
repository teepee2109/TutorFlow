{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MyCnn": "Server=YOUR_SQL_SERVER;Database=TutorFlow;User Id=YOUR_USER;Password=YOUR_PASSWORD;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "TutorFlow.BackEnd",
    "Audience": "TutorFlow.FrontEnd",
    "Key": "REPLACE_WITH_A_RANDOM_KEY_AT_LEAST_32_BYTES_LONG"
  }
}
