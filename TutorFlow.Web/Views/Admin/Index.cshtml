@model TutorFlow.Data.Entities.VwAdminStat
@{
    ViewData["Title"] = "Dashboard Thống kê Hệ thống";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold">📊 Dashboard Quản trị (Admin)</h2>
        <p class="text-muted mb-0">Tổng quan chỉ số hoạt động toàn hệ thống TutorFlow</p>
    </div>
    <div>
        <a asp-controller="Users" asp-action="Index" class="btn btn-primary">
            👥 Quản lý tài khoản
        </a>
        <a asp-controller="Users" asp-action="Facilities" class="btn btn-outline-secondary ms-2">
            🏢 Phân công cơ sở
        </a>
    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
}

<div class="row g-4 mb-4">
    <!-- Cụm Phòng Học -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-primary text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title text-uppercase mb-0 opacity-75">Cơ sở vật chất</h6>
                    <span class="fs-4">🏢</span>
                </div>
                <h2 class="display-6 fw-bold mb-3">@(Model?.TotalRooms ?? 0) <span class="fs-6 fw-normal">phòng</span></h2>
                <div class="d-flex justify-content-between pt-2 border-top border-white-50 small">
                    <span>🟢 Đang mở: <strong>@(Model?.OpenRooms ?? 0)</strong></span>
                    <span>🔴 Đang đóng bảo trì: <strong>@(Model?.ClosedRooms ?? 0)</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cụm Lớp & Người Dùng -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title text-uppercase mb-0 opacity-75">Quy mô đào tạo</h6>
                    <span class="fs-4">🎓</span>
                </div>
                <h2 class="display-6 fw-bold mb-3">@(Model?.ActiveClasses ?? 0) <span class="fs-6 fw-normal">lớp đang mở</span></h2>
                <div class="d-flex justify-content-between pt-2 border-top border-white-50 small">
                    <span>👨‍🏫 Giảng viên: <strong>@(Model?.ActiveLecturers ?? 0)</strong></span>
                    <span>👨‍🎓 Học viên: <strong>@(Model?.ActiveStudents ?? 0)</strong></span>
                </div>
            </div>
        </div>
    </div>

    <!-- Cụm Vận Hành & Tài Chính -->
    <div class="col-md-4">
        <div class="card shadow-sm border-0 bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h6 class="card-title text-uppercase mb-0 opacity-75">Vận hành & Tài chính</h6>
                    <span class="fs-4">⚡</span>
                </div>
                <h2 class="display-6 fw-bold mb-3">@(Model?.PendingChangeRequests ?? 0) <span class="fs-6 fw-normal">yêu cầu chờ duyệt</span></h2>
                <div class="pt-2 border-top border-dark-50 small">
                    <span>💰 Tổng học phí chưa thu: <strong>@(Model?.TotalUnpaidTuition.ToString("N0") ?? "0") VNĐ</strong></span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3">⚡ Lối tắt quản trị</h5>
        <div class="row g-3">
            <div class="col-md-3">
                <a asp-controller="Users" asp-action="Create" class="btn btn-outline-primary w-100 py-3 text-start">
                    <div class="fw-bold">➕ Thêm tài khoản mới</div>
                    <small class="text-muted">Tạo GM, FM, GV hoặc HV</small>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Users" asp-action="Facilities" class="btn btn-outline-info w-100 py-3 text-start">
                    <div class="fw-bold">🏢 Gán người phụ trách cơ sở</div>
                    <small class="text-muted">Phân bổ FM cho 3 cơ sở</small>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Lecturer" class="btn btn-outline-secondary w-100 py-3 text-start">
                    <div class="fw-bold">👨‍🏫 Danh sách giảng viên</div>
                    <small class="text-muted">Xem và quản lý giảng viên</small>
                </a>
            </div>
            <div class="col-md-3">
                <a asp-controller="Users" asp-action="Index" asp-route-roleFilter="Student" class="btn btn-outline-secondary w-100 py-3 text-start">
                    <div class="fw-bold">👨‍🎓 Danh sách học viên</div>
                    <small class="text-muted">Xem và quản lý học viên</small>
                </a>
            </div>
        </div>
    </div>
</div>
