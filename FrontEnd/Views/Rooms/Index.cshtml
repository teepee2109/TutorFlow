@model FrontEnd.Models.RoomGridViewModel
@{
    ViewData["Title"] = "Lưới trạng thái phòng";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold mb-1">🏢 Lưới phòng theo ca</h2>
        <p class="text-muted mb-0">Theo dõi phòng trống, đang sử dụng và đóng bảo trì theo ngày.</p>
    </div>
    <form method="get" asp-action="Index" class="d-flex align-items-end gap-2">
        <div>
            <label for="date" class="form-label mb-1">Ngày xem</label>
            <input id="date" name="date" type="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <button type="submit" class="btn btn-primary">Xem</button>
    </form>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger">@error</div>
}
@if (ViewBag.ErrorMessage is string gridError)
{
    <div class="alert alert-danger">@gridError</div>
}
@if (ViewBag.EmptyRoomsErrorMessage is string emptyError)
{
    <div class="alert alert-warning">Không tải được danh sách phòng trống: @emptyError</div>
}

@if (Model.AffectedRoomId.HasValue)
{
    <div class="card border-warning mb-4">
        <div class="card-header bg-warning-subtle fw-bold">
            Buổi học bị ảnh hưởng khi đóng phòng @(Model.AffectedRoomNumber ?? $"#{Model.AffectedRoomId}")
        </div>
        <div class="card-body">
            @if (ViewBag.AffectedSessionsErrorMessage is string affectedError)
            {
                <div class="alert alert-danger mb-0">@affectedError</div>
            }
            else if (Model.AffectedSessions.Count == 0)
            {
                <p>Không còn buổi Scheduled từ hôm nay trong phòng này. Bạn có thể đóng phòng.</p>
                <form method="post" asp-action="SetCondition">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="roomId" value="@Model.AffectedRoomId" />
                    <input type="hidden" name="condition" value="Closed" />
                    <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                    <button type="submit" class="btn btn-danger">Đóng phòng bảo trì</button>
                </form>
            }
            else
            {
                <p class="text-muted">Dời từng buổi sang phòng trống cùng ca hoặc hủy buổi; sau đó đóng phòng.</p>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead><tr><th>Ngày / ca</th><th>Lớp</th><th>Giảng viên</th><th>Xử lý</th></tr></thead>
                        <tbody>
                            @foreach (var session in Model.AffectedSessions)
                            {
                                <tr>
                                    <td>@session.SessionDate.ToString("dd/MM/yyyy")<div class="small text-muted">@session.ShiftName</div></td>
                                    <td>@session.ClassName</td>
                                    <td>@session.LecturerName</td>
                                    <td>
                                        <div class="d-flex flex-wrap gap-2">
                                            @if (session.AvailableRooms.Count > 0)
                                            {
                                                <form method="post" asp-action="AssignSessionRoom" class="d-flex gap-1">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="sessionId" value="@session.SessionId" />
                                                    <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                                                    <input type="hidden" name="affectedRoomId" value="@Model.AffectedRoomId" />
                                                    <select name="roomId" class="form-select form-select-sm" required>
                                                        <option value="">-- Chọn phòng trống --</option>
                                                        @foreach (var room in session.AvailableRooms)
                                                        {
                                                            <option value="@room.RoomId">@room.RoomNumber · @room.FacilityName</option>
                                                        }
                                                    </select>
                                                    <button type="submit" class="btn btn-sm btn-outline-primary">Dời buổi</button>
                                                </form>
                                            }
                                            <form method="post" asp-action="CancelAffectedSession" onsubmit="return confirm('Hủy buổi học này?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="sessionId" value="@session.SessionId" />
                                                <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                                                <input type="hidden" name="affectedRoomId" value="@Model.AffectedRoomId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger">Hủy buổi</button>
                                            </form>
                                        </div>
                                        @if (session.AvailableRooms.Count == 0)
                                        {
                                            <small class="text-muted">Không có phòng trống cùng ca tại cơ sở này.</small>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr><th>Cơ sở</th><th>Phòng</th><th>Ca</th><th>Trạng thái</th><th>Lớp / giảng viên</th>@if (Model.CanManageRooms) { <th>Thao tác</th> }</tr>
            </thead>
            <tbody>
                @if (Model.Slots.Count == 0)
                {
                    <tr><td colspan="@(Model.CanManageRooms ? 6 : 5)" class="text-center text-muted py-5">Không có dữ liệu phòng cho ngày đã chọn.</td></tr>
                }
                @foreach (var row in Model.Slots)
                {
                    var slot = row.Slot;
                    <tr>
                        <td>@slot.FacilityName</td>
                        <td><strong>@slot.RoomNumber</strong><div class="small text-muted">@(slot.Capacity?.ToString() ?? "—") chỗ</div></td>
                        <td>@slot.ShiftName<div class="small text-muted">@slot.StartTime.ToString("HH:mm")–@slot.EndTime.ToString("HH:mm")</div></td>
                        <td>
                            @if (slot.SlotStatus == "Occupied") { <span class="badge bg-primary">Đang sử dụng</span> }
                            else if (slot.SlotStatus == "Closed for Maintenance") { <span class="badge bg-danger">Đóng bảo trì</span> }
                            else { <span class="badge bg-success">Trống</span> }
                        </td>
                        <td>@(slot.ClassName ?? "—")<div class="small text-muted">@(slot.LecturerName ?? "")</div></td>
                        @if (Model.CanManageRooms)
                        {
                            <td>
                                @if (slot.SlotStatus == "Occupied" && slot.SessionId.HasValue && row.EmptyRooms.Count > 0)
                                {
                                    <form method="post" asp-action="AssignSessionRoom" class="d-flex flex-wrap gap-1">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="sessionId" value="@slot.SessionId" />
                                        <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                                        <input type="hidden" name="affectedRoomId" value="@Model.AffectedRoomId" />
                                        <select name="roomId" class="form-select form-select-sm" required>
                                            <option value="">-- Phòng trống --</option>
                                            @foreach (var room in row.EmptyRooms)
                                            {
                                                <option value="@room.RoomId">@room.RoomNumber · @room.FacilityName</option>
                                            }
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Dời buổi</button>
                                        <label class="small w-100"><input type="checkbox" name="applyToWholeClass" value="true" /> Áp dụng các buổi sắp tới của lớp</label>
                                    </form>
                                }
                                @if (row.ShowRoomConditionAction)
                                {
                                    <form method="post" asp-action="SetCondition" class="mt-1" onsubmit="return confirm('@(slot.RoomCondition == "Closed" ? "Mở lại" : "Đóng bảo trì") phòng @slot.RoomNumber?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="roomId" value="@slot.RoomId" />
                                        <input type="hidden" name="condition" value="@(slot.RoomCondition == "Closed" ? "Open" : "Closed")" />
                                        <input type="hidden" name="date" value="@Model.TargetDate.ToString("yyyy-MM-dd")" />
                                        <button type="submit" class="btn btn-sm @(slot.RoomCondition == "Closed" ? "btn-outline-success" : "btn-outline-danger")">
                                            @(slot.RoomCondition == "Closed" ? "Mở phòng" : "Đóng bảo trì")
                                        </button>
                                    </form>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
