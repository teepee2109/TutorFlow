@model FrontEnd.Models.LoginViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Đăng nhập";
}

<div class="tf-login-layout">
    <section class="tf-login-intro">
        <span class="tf-eyebrow">TUTORFLOW · QUẢN LÝ ĐÀO TẠO</span>
        <h1>Mọi hoạt động trung tâm, trong một nơi.</h1>
        <p>Đăng nhập để quản lý lớp học, lịch trình và các công việc theo vai trò của bạn.</p>
        <div class="tf-login-points"><span><i>✓</i>Lịch học và phòng học</span><span><i>✓</i>Ghi danh và điểm danh</span><span><i>✓</i>Theo dõi học phí</span></div>
    </section>

    <section class="tf-login-card">
        <div class="mb-4"><h2>Chào mừng trở lại</h2><p class="text-muted mb-0">Đăng nhập bằng tài khoản TutorFlow của bạn.</p></div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger" role="alert"><div asp-validation-summary="All" class="text-danger mb-0"></div></div>
        }

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email</label>
                <input asp-for="Email" class="form-control" placeholder="ten@tutorflow.vn" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label">Mật khẩu</label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Nhập mật khẩu" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger small"></span>
            </div>
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div class="form-check"><input asp-for="RememberMe" class="form-check-input" /><label asp-for="RememberMe" class="form-check-label small">Ghi nhớ đăng nhập</label></div>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
        </form>

        @if (HostEnvironment.IsDevelopment())
        {
            <details class="tf-dev-accounts mt-4">
                <summary>
                    <span><strong>Tài khoản kiểm thử</strong><small>Chỉ hiển thị trong môi trường Development</small></span>
                    <span class="tf-dev-chevron" aria-hidden="true">⌄</span>
                </summary>
                <div class="tf-dev-account-content">
                    <div class="tf-dev-password"><span>Mật khẩu chung</span><code>Dev@12345</code></div>
                    <div class="tf-dev-user-list">
                        <div><span>Quản trị viên</span><code>admin@tutorflow.local</code></div>
                        <div><span>Quản lý tổng</span><code>gm@tutorflow.local</code></div>
                        <div><span>Quản lý cơ sở</span><code>fm1@tutorflow.local</code></div>
                        <div><span>Giảng viên</span><code>lecturer1@tutorflow.local</code></div>
                        <div><span>Học viên</span><code>student1@tutorflow.local</code></div>
                    </div>
                </div>
            </details>
        }
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
