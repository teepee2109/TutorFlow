@model FrontEnd.Models.LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập - TutorFlow";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">TutorFlow</h2>
                    <p class="text-muted">Hệ thống quản lý trung tâm dạy thêm (MVC)</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger pb-0">
                        <div asp-validation-summary="All" class="text-danger"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="name@tutorflow.local" autofocus />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Mật khẩu</label>
                        <input asp-for="Password" class="form-control" type="password" placeholder="••••••••" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">Ghi nhớ đăng nhập</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2">Đăng nhập</button>
                </form>

                <div class="mt-4 p-3 bg-light rounded small">
                    <div class="fw-bold mb-1">Tài khoản mặc định môi trường Dev:</div>
                    <div>Mật khẩu chung: <code>Dev@12345</code></div>
                    <ul class="mb-0 ps-3 mt-1 text-muted">
                        <li>Admin: <code>admin@tutorflow.local</code></li>
                        <li>Grand Manager: <code>gm@tutorflow.local</code></li>
                        <li>Facility Manager 1: <code>fm1@tutorflow.local</code></li>
                        <li>Lecturer: <code>lecturer1@tutorflow.local</code></li>
                        <li>Student: <code>student1@tutorflow.local</code></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
